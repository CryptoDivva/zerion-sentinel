# Zerion API key — get from dashboard.zerion.io
ZERION_API_KEY=zk_dev_YOUR_KEY_HERE

# Telegram bot token — get from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Telegram numeric user ID — get from @userinfobot
TELEGRAM_OWNER_ID=YOUR_NUMERIC_ID

# EVM wallet private key — NEVER commit this to git
# Must be 0x followed by 64 hex characters
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: Anthropic API key — enables 3-agent AI consensus (Balthasar/Melchior/Caspar)
ANTHROPIC_API_KEY=
